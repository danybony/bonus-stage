<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="net.bonysoft.bonusstage.widget.BonusStageWidgetReceiver"
            android:exported="true"
            android:label="Bonus Stage">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bonus_stage_widget" />
        </receiver>
        <!-- Share cards: exposes cache/cards only, read access granted per share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.cards"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/card_paths" />
        </provider>
    </application>
</manifest>
