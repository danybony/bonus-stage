<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: without these the app cannot see which browser supports
         Custom Tabs (WebOpener), and every link falls back to the external browser. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application>
        <receiver
            android:name="net.bonysoft.bonusstage.widget.BonusStageWidgetReceiver"
            android:exported="true"
            android:label="Bonus Stage">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bonus_stage_widget" />
        </receiver>
        <!-- Share cards: exposes cache/cards only, read access granted per share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.cards"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/card_paths" />
        </provider>
    </application>
</manifest>
